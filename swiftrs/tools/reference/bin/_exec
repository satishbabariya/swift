#!/usr/bin/env bash
# Runs a Swift 3.1 reference tool inside a long-lived Docker container.
# The swiftrs checkout is bind-mounted at the same path, so absolute paths in
# lit RUN lines resolve identically inside and outside the container.
set -euo pipefail
SWIFTRS="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
IMAGE="${SWIFTRS_REFERENCE_IMAGE:-swift:3.1}"
NAME="${SWIFTRS_REFERENCE_CONTAINER:-swiftrs-ref-3.1}"
TMP="${TMPDIR:-/tmp}"

if [ "$(docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" != "true" ]; then
  docker rm -f "$NAME" >/dev/null 2>&1 || true
  docker run -d --name "$NAME" --platform linux/amd64 \
    -v "$SWIFTRS:$SWIFTRS" -v "$TMP:$TMP" \
    "$IMAGE" sleep infinity >/dev/null
fi
exec docker exec -i -w "$PWD" "$NAME" "$@"
